# Provider credentials
# Groq is the default LLM backend. Its text planner and vision judge use
# separate models; create a key at console.groq.com/keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional override. Use the API root (for example, https://api.groq.com/openai/v1),
# not the /chat/completions endpoint.
GROQ_CHAT_BASE_URL=
GROQ_CHAT_TIMEOUT_SEC=30
GROQ_CHAT_MAX_ATTEMPTS=2
GROQ_CHAT_RETRY_BACKOFF_SEC=1
GROQ_CHAT_MAX_RETRY_DELAY_SEC=5
GROQ_PLANNER_MAX_TOKENS=2048
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
# Strict-schema failover used only after transient planner-provider failures.
GROQ_PLANNER_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MAX_TOKENS=512

# Optional NVIDIA NIM fallback. Set LLM_PROVIDER=nvidia to use it. Generate an
# nvapi- key at build.nvidia.com, or set NVIDIA_CHAT_BASE_URL for self-hosted NIM.
NVIDIA_API_KEY=
NVIDIA_CHAT_BASE_URL=
NVIDIA_CHAT_TIMEOUT_SEC=30
NVIDIA_CHAT_MAX_ATTEMPTS=2
NVIDIA_CHAT_RETRY_BACKOFF_SEC=1
NVIDIA_CHAT_MAX_RETRY_DELAY_SEC=5
NVIDIA_PLANNER_MAX_TOKENS=2048
# GLM is the text planner; Qwen is the visual evaluator.
NVIDIA_PLANNER_MODEL=z-ai/glm-5.2
NVIDIA_VISION_MODEL=qwen/qwen3.5-397b-a17b

# Image generation. Set IMAGE_PROVIDER=cloudflare to replace GMI still-image
# generation with Cloudflare Workers AI. POV mode still needs GMI for video.
IMAGE_PROVIDER=gmi
GMI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
CLOUDFLARE_PRODUCT_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
CLOUDFLARE_IMAGE_WIDTH=768
CLOUDFLARE_IMAGE_HEIGHT=1344
CLOUDFLARE_IMAGE_NUM_STEPS=8
CLOUDFLARE_IMAGE_GUIDANCE=7.5
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
# Set true to synthesize the planner's optional beat voiceover lines with ElevenLabs.
VOICEOVER_ENABLED=false
ELEVENLABS_VOICE_MODEL=eleven_v3
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional LangSmith observability. Traces include prompts and generated asset URLs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reelproof
LANGSMITH_WORKSPACE_ID=

# Backblaze B2
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=reelproof-assets
B2_REGION=us-west-004
# Set this only when B2 objects are served through a public custom domain.
B2_PUBLIC_URL_BASE=
B2_OBJECT_LOCK_ENABLED=false
B2_OBJECT_LOCK_RETENTION_DAYS=365
# Enable only when pyarrow is installed and local Parquet lineage exports are required.
PARQUET_ENABLED=false

# Runtime limits
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_PIXELS=40000000
DATABASE_PATH=jobs.db
DATA_DIR=data
OUTPUT_DIR=output

# Campaign defaults
BEAT_COUNT=5
MAX_AGENT_ITERATIONS=2
JUDGE_PASS_THRESHOLD=0.7
SLIDESHOW_BEAT_DURATION_SEC=3.5
SLIDESHOW_WIDTH=1080
SLIDESHOW_HEIGHT=1920
SLIDESHOW_FPS=25
SLIDESHOW_TRANSITION_SEC=0.35

# Provider fallbacks and bounded retries
GMI_IMAGE_MODEL=reve-create-20250915
GMI_IMAGE_FALLBACK_MODELS=gemini-2.5-flash-image,seedream-5.0-lite
GMI_PRODUCT_IMAGE_MODEL=reve-edit-fast-20251030
GMI_PRODUCT_IMAGE_FALLBACK_MODELS=reve-edit-20250915,reve-remix-fast-20251030
POV_VIDEO_MODEL=pixverse-v5.6-i2v
POV_VIDEO_FALLBACK_MODELS=seedance-1-0-pro-fast,wan2.6-i2v
POV_CLIP_DURATION_SEC=5
POV_MAX_CONCURRENCY=2
POV_PIPELINE_TIMEOUT_SEC=900
IMAGE_STEP_RETRIES=1
AUDIO_STEP_RETRIES=1
VOICEOVER_STEP_RETRIES=1
VIDEO_STEP_RETRIES=1
# A worker renews this lease while rendering; expired work is restarted safely.
JOB_LEASE_SECONDS=1800
