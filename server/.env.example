# Provider credentials
OPENAI_API_KEY=
# NVIDIA NIM key for campaign planning and visual evaluation. Generate an
# nvapi- key at build.nvidia.com, or set NVIDIA_CHAT_BASE_URL for self-hosted NIM.
NVIDIA_API_KEY=
NVIDIA_CHAT_BASE_URL=
# GLM is the creative/structured text planner; Qwen is the visual evaluator.
NVIDIA_PLANNER_MODEL=z-ai/glm-5.2
NVIDIA_VISION_MODEL=qwen/qwen3.5-397b-a17b
GMI_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=

# Backblaze B2
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=reelproof-assets
B2_REGION=us-west-004
# Set this only when B2 objects are served through a public custom domain.
B2_PUBLIC_URL_BASE=
B2_OBJECT_LOCK_ENABLED=false
B2_OBJECT_LOCK_RETENTION_DAYS=365

# Runtime limits
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_PIXELS=40000000
DATABASE_PATH=jobs.db
DATA_DIR=data
OUTPUT_DIR=output

# Campaign defaults
BEAT_COUNT=5
MAX_AGENT_ITERATIONS=2
JUDGE_PASS_THRESHOLD=0.7
SLIDESHOW_BEAT_DURATION_SEC=3.5
SLIDESHOW_WIDTH=1080
SLIDESHOW_HEIGHT=1920
SLIDESHOW_FPS=25
SLIDESHOW_TRANSITION_SEC=0.35
