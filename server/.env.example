# ReelProof minimal local demo config
#
# Defaults live in app/config.py. Keep this file to credentials and local
# resource IDs only.

# Planner + vision judge
GROQ_API_KEY=

# Still-image generation, default provider: Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Background music
STABILITY_API_KEY=

# Backblaze B2 storage
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Override only if your bucket is not in the config.py default region.
B2_REGION=
# Optional durable URL base for a public bucket or CDN. Private buckets work:
# the API signs browser asset URLs without changing URLs stored in manifests.
B2_PUBLIC_URL_BASE=

# Optional: POV video mode still uses GMI video.
# GMI_API_KEY=

# Optional: narration.
# VOICEOVER_ENABLED=true
# ELEVENLABS_API_KEY=
